{
  "name": "@x3i/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "X3 Inspector Chrome extension (Manifest V3, side panel)",
  "scripts": {
    "build": "vite build && vite build --config vite.content.config.ts && vite build --config vite.hook.config.ts",
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@x3i/shared": "0.1.0",
    "@x3i/x3-core": "0.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql-formatter": "^15.9.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.2"
  }
}
