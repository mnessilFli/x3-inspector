    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@x3i/shared": "0.1.0",
    "@x3i/x3-core": "0.1.0",
    "mssql": "^12.7.2",
    "oracledb": "^7.0.1"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/oracledb": "^7.0.3",
    "tsx": "^4.23.15"
  }
}
